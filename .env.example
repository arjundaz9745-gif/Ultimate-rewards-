# ========== REQUIRED - Fill these ==========

# From Discord Developer Portal → Your Application → OAuth2
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Bot Token (OPTIONAL for now)
# Staff is currently controlled by User IDs in server.js
# Later when you have admin + bot invited, you can use role check
DISCORD_BOT_TOKEN=

# Your Discord Server (Guild) ID
DISCORD_GUILD_ID=1542542660458385508

# Staff Role ID (used only when bot is available)
STAFF_ROLE_ID=1548173330794815599

# Session secret (any long random string)
SESSION_SECRET=change_this_to_a_long_random_string_12345

# The public URL of your site (important for OAuth redirect)
# Local: http://localhost:3000
# Render: https://your-app-name.onrender.com
BASE_URL=http://localhost:3000

PORT=3000
